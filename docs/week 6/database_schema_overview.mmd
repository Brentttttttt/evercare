%% Editable monochrome summary. The print-ready PNG is generated by
%% docs/system_documentation/generate_diagrams.py.
flowchart TB
  auth[auth.users<br/>Supabase-managed identity]

  subgraph identity[Identity and trusted care]
    profiles[profiles<br/>id → auth.users.id]
    medical[medical_profiles<br/>user_id → auth.users.id]
    care[caregiver_relationships<br/>older_adult_id / caregiver_id → profiles.id]
    profiles -->|two role FKs| care
  end

  subgraph health[Health and scheduling]
    medications[medications]
    doses[medication_dose_events]
    appointments[appointments]
    bp[blood_pressure_readings]
    medications -->|1:N| doses
  end

  subgraph journal[Journal and safety]
    entries[journal_entries]
    photos[journal_entry_photos]
    contacts[emergency_contacts]
    notifications[notifications]
    entries -->|1:N| photos
  end

  auth --> profiles
  auth --> medical
  auth --> medications
  auth --> doses
  auth --> appointments
  auth --> bp
  auth --> entries
  auth --> photos
  auth --> contacts
  auth --> notifications

  note[RLS is enabled on all 11 public tables.<br/>Photo files are private storage.objects linked by storage_path.]
  identity -.-> note
  health -.-> note
  journal -.-> note

  classDef bw fill:#ffffff,stroke:#111111,color:#111111,stroke-width:1.5px;
  classDef managed fill:#eeeeee,stroke:#111111,color:#111111,stroke-width:1.5px;
  class auth,identity,health,journal,note managed;
  class profiles,medical,care,medications,doses,appointments,bp,entries,photos,contacts,notifications bw;
