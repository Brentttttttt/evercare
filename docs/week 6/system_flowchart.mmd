%% Editable monochrome summary. The print-ready PNG is generated by
%% docs/system_documentation/generate_diagrams.py.
flowchart TB
  launch([Launch EverCare]) --> init[Initialize Flutter, Supabase,<br/>BLE scope, and accessibility preferences]
  init --> session{Active Supabase session?}
  session -- No --> auth[Welcome / Onboarding / Login / Registration]
  auth -->|successful session| shell[Authenticated MainShell<br/>dashboard and eight feature tabs]
  session -- Yes --> shell
  shell --> task{Select a task}

  task --> health[Health capture<br/>BLE monitor or manual entry<br/>validate → assess → explicit Save]
  task --> daily[Daily care records<br/>medicines · visits · journals<br/>CRUD and server-clock RPCs]
  task --> safety[Safety and reference<br/>emergency · profile · Care Book<br/>hospital search and external links]

  health --> boundary[Repositories and services<br/>authenticated Supabase APIs / direct integrations]
  daily --> boundary
  safety --> boundary
  boundary --> rls[Row Level Security / private Storage / Edge Functions]
  rls --> result[Refresh the screen, return to dashboard,<br/>or choose another tab]

  classDef bw fill:#ffffff,stroke:#111111,color:#111111,stroke-width:1.5px;
  classDef decision fill:#eeeeee,stroke:#111111,color:#111111,stroke-width:1.5px;
  class launch,init,auth,shell,health,daily,safety,boundary,rls,result bw;
  class session,task decision;
