flowchart TB
  people[Senior / Caregiver / Family member]
  monitor[YK-IBPA1 BLE blood-pressure monitor]

  subgraph client[Flutter mobile client]
    ui[Presentation and navigation<br/>screens · widgets · named routes · MainShell]
    state[UI state and shared scopes<br/>StatefulWidget · futures · timers · ChangeNotifier]
    domain[Models and business rules<br/>typed records · validation · schedules · BP assessment]
    access[Repositories and services<br/>owner-filtered CRUD · RPCs · Auth · BLE · AI · maps]
    ui --> state --> domain --> access
  end

  people --> ui
  monitor -->|BLE notifications| access

  subgraph supabase[Supabase backend]
    auth[Supabase Auth]
    api[PostgREST and RPC]
    rls[Row Level Security]
    db[(PostgreSQL 17<br/>11 public tables)]
    storage[Private journal-photo Storage]
    edge[Authenticated Edge Functions]
    api --> rls --> db
  end

  subgraph external[External and device services]
    osm[OpenStreetMap tiles<br/>Overpass · Nominatim · Photon]
    groq[Groq API<br/>GPT-OSS model]
    platform[Location · camera · clipboard · files]
    links[Google Maps and NIA links]
  end

  access --> auth
  access --> api
  access --> storage
  access --> edge
  access --> osm
  access --> platform
  access --> links
  edge --> groq

  classDef bw fill:#ffffff,stroke:#111111,color:#111111,stroke-width:1.5px;
  classDef managed fill:#eeeeee,stroke:#111111,color:#111111,stroke-width:1.5px;
