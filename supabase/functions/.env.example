# Copy locally to supabase/functions/.env and replace the value. Do not commit
# the real secret. Set the same secret in the hosted Supabase project before
# deployment: supabase secrets set GROQ_API_KEY=your_key
GROQ_API_KEY=replace_with_your_groq_api_key
# Groq's provider-qualified ID for OpenAI's GPT-OSS 20B model.
GROQ_MODEL=openai/gpt-oss-20b
