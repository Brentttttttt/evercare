# Copy locally to supabase/functions/.env and replace the placeholder.
# Never commit real secrets or include this file in Flutter assets.
# Set GROQ_API_KEY in the hosted Supabase Function secrets before deployment.
GROQ_API_KEY=replace_with_your_groq_api_key
# Optional NVIDIA backup. Leave empty to disable this provider.
NVIDIA_API_KEY=
# Server routing: Groq gpt-oss-120b, Groq gpt-oss-20b, then optional NVIDIA
# gpt-oss-20b. GROQ_MODEL and GEMINI_API_KEY are not used.
# This configuration does not change billing or guarantee unlimited free use.
