# Copy locally to supabase/functions/.env and replace the value. Do not commit
# the real secret. Set the same secret in the hosted Supabase project before
# deployment: supabase secrets set GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_API_KEY=replace_with_your_gemini_api_key
# The backend uses gemini-3.8-flash through the Gemini Developer API.
# No billing setup, paid tools, alternate providers, or model override needed.
